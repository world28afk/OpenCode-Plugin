  "keywords": ["opencode", "opencode-plugin", "cyberbot", "edit", "reply", "message"],
  "license": "MIT",
  "engines": { "opencode": ">=2.0.0" },
  "devDependencies": { "@opencode/plugin": "^2.0.22" }
}
