{
  "name": "oc-workflow",
  "version": "0.1.0",
  "description": "OpenCode workflow harness: named reusable workflow capsules, durable run graph, parallel agents via child sessions, artifacts, resume cache and governance. Ported from the dsh_workflow design for OpenCode.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx",
    "./package.json": "./package.json"
  },
  "files": ["src", "index.ts", "tui.tsx"],
  "keywords": ["opencode", "opencode-plugin", "workflow", "multi-agent", "orchestration"],
  "license": "MIT",
  "engines": { "opencode": ">=2.0.0" },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  }
}
