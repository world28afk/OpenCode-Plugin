  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx",
    "./package.json": "./package.json"
  },
  "files": ["src", "index.ts", "tui.tsx"],
  "keywords": ["opencode", "opencode-plugin", "router", "tier", "reasoning-effort", "laya"],
  "license": "MIT",
  "engines": { "opencode": ">=2.0.0" },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  }
